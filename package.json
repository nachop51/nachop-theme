{
  "name": "nachop-theme",
  "version": "2.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nachop51/nachop-theme.git"
  },
  "module": "src/index.ts",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@types/bun": "latest",
    "@types/chroma-js": "^3.1.2",
    "chroma-js": "^3.2.0",
    "vsce": "^2.15.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "vs-theme-builder": "^2.2.3"
  },
  "bugs": {
    "url": "https://github.com/nachop51/nachop-theme/issues",
    "email": "nachoperalta0@gmail.com"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Nachop Dark Bordered",
        "path": "themes/nachop-dark-bordered.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Nachop Dark",
        "path": "themes/nachop-dark.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Nachop Light Bordered",
        "path": "themes/nachop-light-bordered.json",
        "uiTheme": "vs"
      },
      {
        "label": "Nachop Light",
        "path": "themes/nachop-light.json",
        "uiTheme": "vs"
      },
      {
        "label": "Piggy Bordered",
        "path": "themes/piggy-bordered.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Piggy",
        "path": "themes/piggy.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Nighty Bordered",
        "path": "themes/nighty-bordered.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Dark Juice",
        "path": "themes/dark-juice.json",
        "uiTheme": "vs-dark"
      }
    ]
  },
  "description": "Mix of the best VSCode themes",
  "displayName": "Nachop theme",
  "engines": {
    "vscode": "^1.82.0"
  },
  "homepage": "https://github.com/nachop51/nachop-theme",
  "icon": "images/icon.png",
  "keywords": [
    "theme",
    "dark",
    "light",
    "color",
    "syntax",
    "highlighting",
    "nachop"
  ],
  "license": "MIT",
  "publisher": "nachop51",
  "scripts": {
    "lint": "tsc && bunx --bun biome lint",
    "build": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "package": "bun lint && bun run build && vsce package",
    "publish": "vsce publish"
  }
}